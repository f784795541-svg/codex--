.screen-profile .hero-panel {
  margin-top: 4rpx;
  padding-bottom: 24rpx;
}

.screen-profile .section-caption {
  margin-bottom: 4rpx;
}

.profile-focus-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.profile-focus-chip {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #496a70;
  font-size: 21rpx;
}

.profile-account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 12rpx;
}

.profile-account-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #1b3f46;
}

.support-inline-copy {
  margin-top: 12rpx;
  color: #738d92;
  font-size: 21rpx;
  line-height: 1.56;
}

.device-link-card {
  margin-top: 20rpx;
}

.device-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
}

.device-link-input-row {
  border-top: 1rpx solid #e4eeee;
}

.device-link-label {
  color: #214d55;
  font-size: 24rpx;
  font-weight: 700;
}

.device-link-value {
  margin-top: 6rpx;
  color: #1b7377;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.device-link-note {
  margin-top: 6rpx;
  color: #7a9296;
  font-size: 21rpx;
}

.device-link-button {
  flex-shrink: 0;
  min-width: 140rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #c9dadd;
  border-radius: 999rpx;
  background: #f5faf9;
  color: #285d62;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 62rpx;
}

.device-link-input-copy {
  flex: 1;
  min-width: 0;
}

.device-link-input {
  box-sizing: border-box;
  width: 100%;
  height: 108rpx;
  margin-top: 8rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid #82a8b2;
  border-radius: 16rpx;
  background: #fff;
  color: #385e63;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.device-link-connect {
  background: #214d55;
  border-color: #214d55;
  color: #fff;
}

.profile-save-notice {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(238, 246, 247, 0.95);
  color: #476b71;
  font-size: 21rpx;
  line-height: 1.54;
}

.profile-section-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}

.profile-section-title {
  color: #1c4047;
  font-size: 24rpx;
  font-weight: 700;
}

.profile-section-note {
  color: #7a9296;
  font-size: 21rpx;
  line-height: 1.46;
  text-align: right;
}
