.screen-food-history .hero-panel {
  margin-top: 4rpx;
}

.food-history-hero {
  padding-top: 22rpx;
}

.food-history-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.food-history-back {
  min-width: 140rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #294f57;
  font-size: 25rpx;
  text-align: center;
  font-weight: 600;
}

.food-history-date {
  color: #6d858a;
  font-size: 22rpx;
}

.food-history-list {
  margin-top: 18rpx;
}

.food-history-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(225, 235, 237, 0.92);
}

.food-history-item:first-child {
  padding-top: 6rpx;
}

.food-history-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.food-history-item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.food-history-item-main {
  flex: 1;
  min-width: 0;
}

.food-history-item-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.food-history-item-title {
  color: #18353c;
  font-size: 30rpx;
  line-height: 1.34;
  font-weight: 700;
}

.food-history-item-meta {
  margin-top: 8rpx;
  color: #6d888d;
  font-size: 22rpx;
  line-height: 1.6;
}

.food-history-calorie {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #e4eff0;
  color: #365f66;
  font-size: 22rpx;
  font-weight: 700;
}

.food-history-delete-button {
  min-width: 116rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 999rpx;
  background: rgba(216, 91, 87, 0.12);
  color: #bf4a45;
  font-size: 22rpx;
  line-height: 58rpx;
  font-weight: 700;
}

.food-history-delete-button::after {
  border: 0;
}

.food-history-delete-button[disabled] {
  background: rgba(191, 74, 69, 0.08);
  color: rgba(191, 74, 69, 0.55);
}

.food-history-macro-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.food-history-macro-card {
  padding: 16rpx 14rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #eef6f7 0%, #e7f0f1 100%);
}

.food-history-macro-label {
  color: #748f93;
  font-size: 20rpx;
}

.food-history-macro-value {
  margin-top: 8rpx;
  color: #18353c;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 700;
}

.food-history-back-button {
  margin-top: 22rpx;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  color: #6d888d;
  font-size: 24rpx;
  line-height: 1.8;
}
