page { background: #edf3f5; color: #173039; }
.pk-page { padding: 32rpx 26rpx 60rpx; }
.pk-kicker,.pk-label { color: #668881; font-size: 21rpx; font-weight: 700; }
.pk-title { margin-top: 8rpx; font-size: 44rpx; font-weight: 800; }
.pk-subtitle,.pk-note { color: #698080; font-size: 23rpx; line-height: 1.6; }
.pk-subtitle { margin: 6rpx 0 24rpx; }
.pk-toolbar { display: flex; gap: 12rpx; margin: 14rpx 0; }
.pk-toolbar button { flex: 1; }
button { margin: 12rpx 0 0; padding: 0 20rpx; border-radius: 16rpx; background: #fff; color: #416c64; font-size: 24rpx; line-height: 72rpx; }
button::after { border: 0; }
button.primary { background: #4c8278; color: white; }
.pk-card,.pk-dialog { margin-top: 12rpx; padding: 26rpx; border: 1rpx solid #dce8e7; border-radius: 20rpx; background: #fff; }
.pk-dialog { background: #e2f0ea; }
.pk-dialog input { box-sizing: border-box; width: 100%; height: 88rpx; margin: 24rpx 0; padding: 0 20rpx; border: 1rpx solid #b8d0cb; border-radius: 12rpx; background: white; }
.pk-dialog button { display: inline-block; width: auto; min-width: 150rpx; margin: 4rpx 12rpx 0 0; padding: 0 22rpx; line-height: 62rpx; }
.pk-dialog-title,.pk-match-title { margin: 10rpx 0; font-size: 30rpx; font-weight: 700; }
.pk-code { font-size: 48rpx; font-weight: 800; color: #245c53; }
.pk-match { min-height: 260rpx; background: #e1efed; }
.pk-versus { display: flex; align-items: center; justify-content: space-around; margin: 30rpx 0; text-align: center; }
.pk-avatar { display: grid; width: 92rpx; height: 92rpx; margin: 0 auto 8rpx; place-items: center; border: 7rpx solid white; border-radius: 28rpx; background: #b9ded6; font-weight: 700; }
.pk-avatar.peer { background: #d6d4ef; }
.pk-vs { color: #86a19d; font-weight: 700; }
.pk-stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.pk-purple { background: #eef0fb; }.pk-green { background: #edf7f3; }
.pk-value { margin: 20rpx 0 8rpx; font-size: 52rpx; font-weight: 800; }.pk-value text { font-size: 23rpx; color: #718783; }
.pk-calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 9rpx; margin: 20rpx 0; }
.pk-day { display: flex; flex-direction: column; justify-content: space-between; min-height: 65rpx; padding: 8rpx; border-radius: 10rpx; background: #f0f5f4; color: #7e9190; font-size: 20rpx; }
.pk-day.done { background: #a9d4c6; color: #214d44; }.pk-day text:last-child { font-size: 18rpx; }
.pk-workout-split, .pk-habit-split { position: relative; overflow: hidden; background: #f0f4f2; }
.pk-workout-split.own, .pk-habit-split.own { background: linear-gradient(135deg, #8fc5b4 0 49%, transparent 50%); }
.pk-workout-split.peer, .pk-habit-split.peer { background: linear-gradient(315deg, #9dadd5 0 49%, transparent 50%); }
.pk-workout-split.own.peer, .pk-habit-split.own.peer { background: linear-gradient(135deg, #b9a6dc 0 49%, #9dadd5 50%); }
.pk-rules { background: #f0f5f3; }.pk-error { margin-top: 16rpx; color: #a44646; font-size: 24rpx; }
.pk-renewal { margin-top: 16rpx; padding: 24rpx; border: 1rpx solid #bbdad0; border-radius: 20rpx; background: #e0f2e9; animation: pk-arrive .4s cubic-bezier(.2,1.25,.4,1); }
.pk-habit-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.pk-habit-head > view { min-width: 0; }
.pk-small { flex: none; width: auto; margin: 0; padding: 0 18rpx; line-height: 60rpx; font-size: 22rpx; }
.pk-month { display: flex; justify-content: center; align-items: center; gap: 28rpx; margin: 16rpx 0; color: #426c62; }
.pk-month button { width: 60rpx; margin: 0; padding: 0; line-height: 58rpx; }
.pk-habit-form { margin-top: 18rpx; }
.pk-habit-form input { box-sizing: border-box; width: 100%; height: 80rpx; margin: 10rpx 0; padding: 0 20rpx; border: 1rpx solid #b8d0cb; border-radius: 12rpx; background: white; }
.pk-form-actions { display: flex; gap: 12rpx; }
.pk-habit-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; border-top: 1rpx solid #e0eae6; padding-top: 14rpx; margin-top: 14rpx; }
.pk-habit-row .pk-match-title { min-width: 0; overflow-wrap: anywhere; }
.pk-habit-calendar { background: #f2f4fb; }
.pk-habits { order: 1; }.pk-habit-calendar { order: 2; }.pk-stat-grid { order: 3; }.pk-calendar { order: 4; }.pk-rules { order: 5; }
.pk-habit-calendar .pk-day { background: #e9edf5; color: #71808c; }
.pk-habit-calendar .pk-day.done { background: #aabde0; color: #243c62; }
.pk-workout-split.own { background: linear-gradient(to bottom, #8fc5b4 0 50%, #f0f4f2 50%); }
.pk-workout-split.peer { background: linear-gradient(to bottom, #f0f4f2 0 50%, #9dadd5 50%); }
.pk-workout-split.own.peer { background: linear-gradient(to bottom, #8fc5b4 0 50%, #9dadd5 50%); }
.pk-habit-calendar .pk-habit-split.own { background: linear-gradient(135deg, #b9a6dc 0 49%, #e9edf5 50%); }
.pk-habit-calendar .pk-habit-split.peer { background: linear-gradient(135deg, #e9edf5 0 49%, #9dadd5 50%); }
.pk-habit-calendar .pk-habit-split.own.peer { background: linear-gradient(135deg, #b9a6dc 0 49%, #9dadd5 50%); }
.pk-habit-calendar-entry + .pk-habit-calendar-entry { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #dce3ec; }
@keyframes pk-arrive { from { opacity: 0; transform: translateY(-12rpx) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
