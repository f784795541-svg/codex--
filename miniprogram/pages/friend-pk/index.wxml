<view class="pk-page">
  <view class="pk-heading"><view class="pk-kicker">SOCIAL MODE / 07</view><view class="pk-title">好友 PK</view><view class="pk-subtitle">一起完成，今天更容易坚持。</view></view>
  <view class="pk-loading" wx:if="{{loading}}">正在加载...</view>
  <block wx:if="{{data}}">
    <view class="pk-toolbar"><button bindtap="showCode">查看匹配码</button><button class="primary" wx:if="{{!data.challenge}}" bindtap="showInvite">发起邀战</button></view>
    <view class="pk-dialog" wx:if="{{dialog}}">
      <block wx:if="{{dialog === 'code'}}"><view class="pk-label">我的匹配码 · 24 小时有效</view><view class="pk-code">{{code}}</view><view class="pk-note">分享给好友，好友输入后即可发起邀战。</view><button class="primary" bindtap="copyCode">复制匹配码</button></block>
      <block wx:else><view class="pk-label">发起邀战</view><view class="pk-dialog-title">输入好友的匹配码</view><input placeholder="输入 8 位匹配码" maxlength="16" value="{{inputCode}}" bindinput="onCodeInput"/><button class="primary" bindtap="sendInvite">发送邀战</button></block>
      <button bindtap="closeDialog">关闭</button>
    </view>
    <view class="pk-card pk-match">
      <view class="pk-label">7 天坚持赛</view>
      <block wx:if="{{!data.challenge}}"><view class="pk-match-title">邀请一个人，一起坚持。</view><view class="pk-note">输入好友匹配码，对方确认后开始。</view><button class="primary" bindtap="showInvite">发起邀战 →</button></block>
      <block wx:elif="{{data.challenge.status === 'pending'}}"><view class="pk-match-title">{{data.challenge.incoming ? data.challenge.peer_name + ' 邀请你挑战' : '已向 ' + data.challenge.peer_name + ' 发出邀战'}}</view><view class="pk-note">{{data.challenge.incoming ? '接受后从今天开始，连续 7 天记录运动。' : '等待对方在好友 PK 页面确认。'}}</view><view class="pk-toolbar"><button wx:if="{{data.challenge.incoming}}" class="primary" data-action="accept" bindtap="changeChallenge">接受挑战</button><button wx:if="{{data.challenge.incoming}}" data-action="decline" bindtap="changeChallenge">婉拒</button><button wx:else data-action="leave" bindtap="changeChallenge">撤回邀战</button></view></block>
      <block wx:else><view class="pk-note">{{data.challenge.start_date}} 至 {{data.challenge.end_date}}</view><view class="pk-versus"><view><view class="pk-avatar">你</view><view>我</view><view class="pk-note">{{data.challenge.own_days}} 天 · {{data.challenge.own_minutes}} 分钟</view></view><text class="pk-vs">VS</text><view><view class="pk-avatar peer">友</view><view>{{data.challenge.peer_name}}</view><view class="pk-note">{{data.challenge.peer_days}} 天 · {{data.challenge.peer_minutes}} 分钟</view></view></view><view class="pk-note">先比打卡天数，同分比总时长</view><button data-action="leave" bindtap="changeChallenge">退出挑战</button></block>
    </view>
    <view class="pk-stat-grid"><view class="pk-card pk-purple"><view class="pk-label">本次运动打卡</view><view class="pk-value">{{data.challenge.status === 'active' ? data.challenge.own_days : '—'}} <text>/ 7 天</text></view><view class="pk-note">有运动记录即点亮</view></view><view class="pk-card pk-green"><view class="pk-label">体重变化</view><view class="pk-value">{{data.challenge.weight_change !== null && data.challenge.weight_change !== undefined ? data.challenge.weight_change : '—'}} <text>kg</text></view><view class="pk-note">仅供自己参考</view></view></view>
    <view class="pk-card pk-calendar"><view class="pk-label">近 30 天 · {{count}} 天已点亮</view><view class="pk-match-title">运动打卡日历</view><view class="pk-calendar-grid"><view class="pk-day {{item.minutes ? 'done' : ''}}" wx:for="{{days}}" wx:key="date" data-date="{{item.date}}" data-minutes="{{item.minutes}}" bindtap="showDay"><text>{{item.day}}</text><text>{{item.minutes ? item.minutes + '分' : ''}}</text></view></view><view class="pk-note">当天有运动记录即点亮，点击查看时长。</view></view>
    <view class="pk-card pk-rules"><view class="pk-label">对战规则</view><view class="pk-match-title">运动记录自动计入</view><view class="pk-note">7 天内按运动天数排名，天数相同时比较总时长。体重变化不计胜负。</view><button bindtap="goWorkout">去记录运动 →</button><view class="pk-note">微信提醒尚未接入，目前不会向对方发送微信消息。</view></view>
  </block>
  <view class="pk-error" wx:if="{{error}}">{{error}}</view><button wx:if="{{error && !data}}" bindtap="load">重试</button>
</view>
