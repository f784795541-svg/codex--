.onboarding-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(19, 45, 51, 0.46);
}

.onboarding-focus {
  position: fixed;
  z-index: 1001;
  box-sizing: border-box;
  border: 4rpx solid #9de4df;
  border-radius: 26rpx;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.7), 0 0 0 10rpx rgba(102, 204, 197, 0.22);
  pointer-events: none;
}

.onboarding-card {
  position: fixed;
  z-index: 1002;
  right: 28rpx;
  bottom: 36rpx;
  left: 28rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid rgba(210, 232, 231, 0.96);
  border-radius: 28rpx;
  background: #f9fdfd;
  box-shadow: 0 18rpx 44rpx rgba(18, 48, 54, 0.2);
}

.onboarding-step {
  color: #6f8d91;
  font-size: 20rpx;
  line-height: 1.3;
}

.onboarding-title {
  margin-top: 8rpx;
  color: #173d45;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.34;
}

.onboarding-copy {
  margin-top: 10rpx;
  color: #5d797e;
  font-size: 23rpx;
  line-height: 1.62;
}

.onboarding-next {
  width: 100%;
  min-height: 72rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #214d55;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
}
