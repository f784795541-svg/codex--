ons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Dolsot_Bibimbap_-_Stone_Bowl_Bibimbap_-_Kimchi_and_Bab_%28543866063%29.jpg/960px-Dolsot_Bibimbap_-_Stone_Bowl_Bibimbap_-_Kimchi_and_Bab_%28543866063%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":720,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Dolsot_Bibimbap_-_Stone_Bowl_Bibimbap_-_Kimchi_and_Bab_%28543866063%29.jpg/1920px-Dolsot_Bibimbap_-_Stone_Bowl_Bibimbap_-_Kimchi_and_Bab_%28543866063%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/4/4f/Dolsot_Bibimbap_-_Stone_Bowl_Bibimbap_-_Kimchi_and_Bab_%28543866063%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Dolsot_Bibimbap_-_Stone_Bowl_Bibimbap_-_Kimchi_and_Bab_(543866063).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=83134484","extmetadata":{"DateTime":{"value":"2019-10-16 13:51:41","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Dolsot Bibimbap - Stone Bowl Bibimbap - Kimchi and Bab (543866063)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Flickr images reviewed by FlickreviewR 2|Files from rice tag of Alpha Flickr stream uploaded by Netha Hussain|Food and drink by restaurant in Melbourne|Bibimbap in Australia|Korean cuisine in Melbourne","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<p>Dolsot Bibimbap - Stone Bowl Bibimbap - Kimchi and Bab\n</p><p>Aunt Lay Leong wanted to treat Aunt Lee Leng to a dinner before she left Melbourne, and I did the organising. The suggestion was to have Korean, so I dug Kimchi and Bab up from the &lt;a href=\"<a rel=\"nofollow\" class=\"external free\" href=\"http://miettas.com/Australia/Victoria/Caulfield_East/Kimchi_And_Bab.html\">http://miettas.com/Australia/Victoria/Caulfield_East/Kimchi_And_Bab.html</a>\"&gt;The Age Cheap Eats 2007&lt;/a&gt; and the &lt;a href=\"<a rel=\"nofollow\" class=\"external free\" href=\"https://www.theage.com.au/news/restaurant-reviews/kimchi-and-bab/2006/04/24/1145861275816.html\">https://www.theage.com.au/news/restaurant-reviews/kimchi-and-bab/2006/04/24/1145861275816.html</a>\"&gt;The Age&lt;/a&gt; reviews.\n</p><p>I don't know why I didn't bother to check if they are used to large crowds! When we got there, we were shown to 2 separate tables. It's a good thing the waitress was helpful. She was probably the owner's daughter, so it was in her interests. Then we find out that they only serve bottled drinks and tap water, no Korean barley or corn tea.\n</p><p>As with all \"homestyle\" cooking, the service was a bit slow, but I guess it was worth the wait.\n</p><p>Kimchi and Bab\n7 Derby Rd, Carnegie\n(03) 9572 2792\n</p><p>Reviews:\n- &lt;a href=\"<a rel=\"nofollow\" class=\"external free\" href=\"https://www.theage.com.au/news/restaurant-reviews/kimchi-and-bab/2006/04/24/1145861275816.html\">https://www.theage.com.au/news/restaurant-reviews/kimchi-and-bab/2006/04/24/1145861275816.html</a>\"&gt;Kimchi and Bab, by Matt Preston, The Age, April 25, 2006&lt;/a&gt;\n- &lt;a href=\"<a rel=\"nofollow\" class=\"external free\" href=\"http://miettas.com/Australia/Victoria/Caulfield_East/Kimchi_And_Bab.html\">http://miettas.com/Australia/Victoria/Caulfield_East/Kimchi_And_Bab.html</a>\"&gt;Kimchi And Bab - Mietta's&lt;/a&gt;\n</p><p><br>\nPhotos:\n- &lt;a href=\"/photos/avlxyz/543765100/\"&gt;Hungry Diners&lt;/a&gt;\n- &lt;a href=\"/photos/avlxyz/543765476/\"&gt;JX, Jean Ni, Feng, Fei Ni, Aunt Lee Leng&lt;/a&gt;\n- &lt;a href=\"/photos/avlxyz/543865243/\"&gt;Aunts Lee Leng, Lee Geok, Lay Leong digging in&lt;/a&gt;\n- &lt;a href=\"/photos/avlxyz/543865537/\"&gt;Mandu - Panfried Dumplings&lt;/a&gt;\n- &lt;a href=\"/photos/avlxyz/543865781/\"&gt;Crabstick Salad Banchan&lt;/a&gt;\n- &lt;a href=\"/photos/avlxyz/543767484/\"&gt;Pork Bulgogi&lt;/a&gt;\n- &lt;a href=\"/photos/avlxyz/543767126/\"&gt;Samgyetang - Ginseng Chicken&lt;/a&gt;\n- &lt;a href=\"/photos/avlxyz/543867291/\"&gt;Nakji - Spicy Baby Octopus&lt;/a&gt;\n- &lt;a href=\"/photos/avlxyz/543768176/\"&gt;Beef Teriyaki&lt;/a&gt;\n</p>\n- &lt;a href=\"/photos/avlxyz/543866063/\"&gt;Dolsot Bibimbap - Stone Bowl Bibimbap&lt;/a&gt;","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2007-06-08 20:21","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/avlxyz/543866063/\">Dolsot Bibimbap - Stone Bowl Bibimbap - Kimchi and Bab</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/10559879@N00\">Alpha</a> from Melbourne, Australia","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-2.0","source":"commons-templates","hidden":""}}}]},"139311764":{"pageid":139311764,"ns":6,"title":"File:Food sources of sodium (sodium-rich foods).pdf","index":8,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Food_sources_of_sodium_%28sodium-rich_foods%29.pdf/page1-960px-Food_sources_of_sodium_%28sodium-rich_foods%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":1387,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Food_sources_of_sodium_%28sodium-rich_foods%29.pdf/page1-960px-Food_sources_of_sodium_%28sodium-rich_foods%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":1387},"url":"https://upload.wikimedia.org/wikipedia/commons/b/b2/Food_sources_of_sodium_%28sodium-rich_foods%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Food_sources_of_sodium_(sodium-rich_foods).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=139311764","extmetadata":{"DateTime":{"value":"2023-10-21 21:20:10","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Food sources of sodium (sodium-rich foods)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Self-published work|Nutrition information charts|Sodium in biology and medicine","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"About 97.7% of foods contained sodium. On the basis of the proposed method, the averages (%) of sodium free, very low sodium, and low sodium foods in food groups were 21.31%, 38.12%, and 55.47%, respectively. Beef products with 98.96%, fruits and fruit juices with 98.88%, lamb, veal, and game products with 95.02%, baby foods with 92.6%, nut and seed products with 89.05%, cereal grains and pasta with 87.85%, sweets with 84.13%, spices and herbs with 83.08%, and beverages with 79.36% had the highest averages (%) of low sodium foods. In contrast, meals, entrees, and side dishes with 1.14%, sausages and luncheon meats with 1.76%, fast foods with 2.03%, restaurant foods with 3.26%, soups, sauces, and gravies with 3.28%, baked products with 24.35%, and breakfast cereals with 26.14% had the lowest averages (%) of low sodium foods. Most foods containing inappropriate sodium levels were allocated to foods containing added sodium.<br>\n<p>The highest amounts of sodium were found in table salt, baking soda, seasoning mix (salt added), salted mackerel, baking powder (except low sodium), salted jellyfish, rennet tablets (salt added), salted tofu, fish sauce (salt added), salted cod, soy sauce (salt added), shrimp (salt added), salted egg, sunflower seed kernels (salt added), canned sweet peppers (salt added), stuffing mix (salt added), cured pork (salt added), pulled pork in barbecue sauce (salt added), sandwich (salt added), mozzarella sticks (salt added), chicken strips (salt added), pizza (salt added), corned beef, soup (salt added), salami (salt added), breaded chicken (salt added), chicken parmigiana (salt added), broth or bouillon (salt added), teriyaki sauce (salt added), miso, canned anchovy (salt added), lox salmon, cheese enchilada (salt added), pasta in sauce (salt added), chili con carne (salt added), chili (salt added), cheese sauce (salt added), breakfast cereal (salt added), fried mozzarella (salt added), rice and vermicelli (salt added), wasabi (salt added), lasagna (salt added), chicken nuggets (salt added), chicken and dumplings (salt added), rice (salt added), hotcakes and sausage (salt added), seasoned turkey (salt added), crab (salt added), onion rings (salt added), canned clam and tomato juice (salt added), papad (salt added), sriracha sauce (salt added), macaroni and cheese (salt added), chili powder (salt added), canned grape leaves (salt added), dried steelhead trout (salt added), breaded fish (salt added), smoked turkey (salt added), cured beef (salt added), oyster sauce (salt added), summer sausage (salt added), pork skins (salt added), hot sauce (salt added), meatballs and mozzarella (salt added), fish broth (salt added), luncheon meat (salt added), turkey and gravy (salt added), orange chicken (salt added), chicken pot pie (salt added), pumpkin and squash seeds (salt added), beef stew (salt added), bologna sausage (salt added), refried beans (salt added), ravioli (salt added), potato salad (salt added), spaghetti sauce (salt added), barbecue loaf (salt added), chicken and rice (salt added), Salisbury steak with gravy (salt added), Berliner sausage (salt added), turkey sticks (salt added), glazed chicken wings (salt added), canned capers (salt added), cheese tamales (salt added), ham (salt added), pancakes (salt added), tomato juice (salt added), mortadella (salt added), and beef breakfast strips (salt added).<br><br>\n</p>\n<b>Suggested citation:</b> Forouzesh, Abed; Forouzesh, Fatemeh; Samadi Foroushani, Sadegh; Forouzesh, Abolfazl. A new method for calculating sodium content and determining appropriate sodium levels in foods. SSRN 2022. DOI: <a rel=\"nofollow\" class=\"external text\" href=\"https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4133574\">10.2139/ssrn.4133574</a>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2022-06-16","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:SSamadi15&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:SSamadi15 (page does not exist)\">SSamadi15</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-4.0","source":"commons-templates","hidden":""}}}]},"16377276":{"pageid":16377276,"ns":6,"title":"File:Hoka Hoka Bento Bento Special 4.jpg","index":7,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Hoka_Hoka_Bento_Bento_Special_4.jpg/960px-Hoka_Hoka_Bento_Bento_Special_4.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":720,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Hoka_Hoka_Bento_Bento_Special_4.jpg/1920px-Hoka_Hoka_Bento_Bento_Special_4.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Hoka_Hoka_Bento_Bento_Special_4.jpg/960px-Hoka_Hoka_Bento_Bento_Special_4.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":720,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Hoka_Hoka_Bento_Bento_Special_4.jpg/1920px-Hoka_Hoka_Bento_Bento_Special_4.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/a/ae/Hoka_Hoka_Bento_Bento_Special_4.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Hoka_Hoka_Bento_Bento_Special_4.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=16377276","extmetadata":{"DateTime":{"value":"2011-09-07 19:18:53","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Hoka Hoka Bento Bento Special 4","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with C