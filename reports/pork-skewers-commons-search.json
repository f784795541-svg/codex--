dex.php?curid=190207686","extmetadata":{"DateTime":{"value":"2026-04-24 05:16:01","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"DFC 2095 Savory grilled pork skewers sizzling and caramelized to a perfect golden-brown","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Rayong|Mueang Rayong District|Meat dishes of Thailand|Files with coordinates missing SDC location of creation|Flickr images reviewed by FlickreviewR 2","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"12.684302","source":"commons-desc-page"},"GPSLongitude":{"value":"101.270725","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"This photo shows several skewers of what appears to be marinated meat, likely pork or chicken, grilled or barbecued to a rich, caramelized golden-brown color. The meat pieces are threaded onto wooden skewers and placed on what looks like a metal grill or cooling rack. The meat has a glossy appearance, suggesting it's been glazed with a savory marinade that could include ingredients like soy sauce, honey, or other seasonings that create that distinctive shine and color. This style of preparation resembles various Asian grilled skewer dishes such as yakitori (Japanese), satay (Southeast Asian), or similar skewered meat preparations found across many cultures. The food looks juicy and flavorful, with visible char marks that indicate it was grilled at high heat, which helps to develop those complex caramelized flavors.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2025-10-11 19:50:20","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/194424926@N05/54847684607\">Flickr</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"