commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Skewers_of_meat_at_a_yatai_beside_Naka-gawa,_Fukuoka,_Japan_-_20110525.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=15331556","extmetadata":{"DateTime":{"value":"2011-05-28 16:25:58","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Skewers of meat at a yatai beside Naka-gawa, Fukuoka, Japan - 20110525","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Sony DSLR-A230|Self-published work|Chicken gizzard as food|Food on skewers in Japan|Yatai in Fukuoka, Fukuoka|Chicken offal dishes|Street food in Fukuoka","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Barbequed meat and vegetables on skewers from a <i><a href=\"https://en.wikipedia.org/wiki/yatai_(retail)\" class=\"extiw\" title=\"w:yatai (retail)\">yatai</a></i> beside the Naka-gawa (Naka river) in <a href=\"https://en.wikipedia.org/wiki/Fukuoka,_Fukuoka\" class=\"extiw\" title=\"w:Fukuoka, Fukuoka\">Fukuoka</a>, <a href=\"https://en.wikipedia.org/wiki/Fukuoka_Prefecture\" class=\"extiw\" title=\"w:Fukuoka Prefecture\">Fukuoka Prefecture</a>, Japan. From left to right, they are: one skewer of chicken <a href=\"https://en.wikipedia.org/wiki/gizzard\" class=\"extiw\" title=\"w:gizzard\">gizzards</a>, three skewers of roasted pork, two skewers of chicken <a href=\"https://en.wikipedia.org/wiki/cartilage\" class=\"extiw\" title=\"w:cartilage\">cartilage</a>, one skewer of sausage, and three skewers of <i><a href=\"https://en.wikipedia.org/wiki/enokitake\" class=\"extiw\" title=\"w:enokitake\">enokitake</a></i> mushrooms wrapped with bacon. The two glasses behind the dish are filled with <a href=\"https://en.wikipedia.org/wiki/sake\" class=\"extiw\" title=\"w:sake\">sake</