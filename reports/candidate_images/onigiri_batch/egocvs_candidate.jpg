<script>
    whirRootVideo.banner('.HomeBan');
    function updatePagination(swiper) {
        var current = swiper.activeIndex + 1;
        var slidesLength = swiper.slides.length;

        var formattedCurrent = current < 10 ? '0' + current : current;
        var formattedCurrent2 = slidesLength < 10 ? '0' + slidesLength : slidesLength;
        $('.HomeBan .swiper-pagination-info .current').text(formattedCurrent);
        $('.HomeBan .swiper-pagination-info .total').text(formattedCurrent2);
    };

</script>



