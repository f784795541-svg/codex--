<script>
	var searchinput = document.getElementById("TopKey");
	$("#TopBtn").click(function () {
		if (searchinput.value == "" || searchinput.value == "输入关键词...") {
			alert("请填写需要搜索的内容！");
			searchinput.focus();
			return false;
		}


		if (searchinput.value.length > 50) {
			alert("输入的关键词字数不要过多！");
			searchinput.focus();
			return false;
		}
		var pattern = new RegExp("[`~!@#$^&*()=|{}':;',\\[\\].<>/?~！@#￥……&*（）—|{}【】‘；：”“'。，、？]");
		if(pattern.test(searchinput.value))
		{
			alert("您输入的内容存在特殊字符!");
			searchinput.focus();
			return false;
		}
		window.location = "/ego/search?page=1&con=" + encodeURI(encodeURI(searchinput.value));
		return true;
	});
	$('ytable-cell top-search').click(function () {
		$(window).keyup(function (event) {
			if (event.keyCode == 13) {
				window.location.href = "/ego/search?page=1&con=" + $.trim($("#TopKey").val());
			}
		});
	})


	$(document).ready(function() {
		$('#TopKey').keypress(function(event) {
			if (event.which == 13) { 
				if (searchinput.value == "" || searchinput.value == "输入关键词...") {
					alert("请填写需要搜索的内容！");
					searchinput.focus();
					return false;
				}

				if (searchinput.value.length > 50) {
					alert("输入的关键词字数不要过多！");
					searchinput.focus();
					return false;
				}
				var pattern = new RegExp("[`~!@#$^&*()=|{}':;',\\[\\].<>/?~！@#￥……&*（）—|{}【】‘；：”“'。，、？]");
				if(pattern.test(searchinput.value))
				{
					alert("您输入的内容存在特殊字符!");
					searchinput.focus();
					return false;
				}
				window.location = "/ego/search?page=1&con=" + encodeURI(encodeURI(searchinput.value));
				return true;
				event.preventDefault(); 
			}
		});
	});


</script>

