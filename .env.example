POSTGRES_DB=health_db
POSTGRES_USER=health_user
# Production must change this value before first deployment.
# Use a long random password and keep the real value only in .env.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_IMAGE=postgres:16-alpine
PYTHON_BASE_IMAGE=python:3.12-slim
NGINX_BASE_IMAGE=nginx:1.27-alpine

# Production must change this. It signs login tokens.
APP_SECRET_KEY=CHANGE_ME_LONG_RANDOM_TOKEN_SIGNING_SECRET
ACCESS_TOKEN_TTL_SECONDS=2592000
# Optional. Set this to enable protected /maintenance/summary.
MAINTENANCE_TOKEN=CHANGE_ME_LONG_RANDOM_MAINTENANCE_TOKEN

BACKEND_PORT=8000
FRONTEND_PORT=8080
